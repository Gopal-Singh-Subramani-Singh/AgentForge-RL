{"event": "artifact", "agent": "developer", "file": "app.py", "content": "class Inventory:\n    def __init__(self):\n        self.products = {}\n\n    def add_product(self, name, quantity=0):\n        if not isinstance(name, str) or not name:\n            raise ValueError(\"Product name must be a non-empty string.\")\n        if not isinstance(quantity, int) or quantity < 0:\n            raise ValueError(\"Initial quantity must be a non-negative integer.\")\n        if name in self.products:\n            raise ValueError(\"Duplicate product name.\")\n        self.products[name] = quantity\n\n    def stock_in(self, name, quantity):\n        if not isinstance(name, str) or not name:\n            raise ValueError(\"Product name must be a non-empty string.\")\n        if not isinstance(quantity, int) or quantity <= 0:\n            raise ValueError(\"Stock in quantity must be a positive integer greater than 0.\")\n        if name not in self.products:\n            raise KeyError(\"Unknown product.\")\n        self.products[name] += quantity\n\n    def stock_out(self, name, quantity):\n        if not isinstance(name, str) or not name:\n            raise ValueError(\"Product name must be a non-empty string.\")\n        if not isinstance(quantity, int) or quantity <= 0:\n            raise ValueError(\"Stock out quantity must be a positive integer greater than 0.\")\n        if name not in self.products:\n            raise KeyError(\"Unknown product.\")\n        if self.products[name] < quantity:\n            raise ValueError(\"Insufficient quantity in stock.\")\n        self.products[name] -= quantity\n\n    def get_quantity(self, name):\n        if not isinstance(name, str) or not name:\n            raise ValueError(\"Product name must be a non-empty string.\")\n        if name not in self.products:\n            raise KeyError(\"Unknown product.\")\n        return self.products[name]\n\n    def list_products(self):\n        return self.products.copy()"}
{"event": "agent_end", "agent": "developer", "step": 0}
