{"event": "artifact", "agent": "developer", "file": "app.py", "content": "class TodoService:\n    def __init__(self):\n        self.todos = []\n        self.next_id = 1\n\n    def create_todo(self, title):\n        if not title.strip():\n            raise ValueError(\"Title cannot be empty\")\n        todo = {'id': self.next_id, 'title': title, 'completed': False}\n        self.todos.append(todo)\n        self.next_id += 1\n        return todo\n\n    def get_todo(self, todo_id):\n        for todo in self.todos:\n            if todo['id'] == todo_id:\n                return todo\n        raise KeyError(f\"Todo with ID {todo_id} not found\")\n\n    def list_todos(self):\n        return self.todos\n\n    def complete_todo(self, todo_id):\n        todo = self.get_todo(todo_id)\n        todo['completed'] = True\n        return todo\n\n    def delete_todo(self, todo_id):\n        todo = self.get_todo(todo_id)\n        self.todos.remove(todo)\n        return todo\n\n# Create a singleton instance of TodoService\ntodo_service = TodoService()\n\ndef create_todo(title):\n    return todo_service.create_todo(title)\n\ndef get_todo(todo_id):\n    return todo_service.get_todo(todo_id)\n\ndef list_todos():\n    return todo_service.list_todos()\n\ndef complete_todo(todo_id):\n    return todo_service.complete_todo(todo_id)\n\ndef delete_todo(todo_id):\n    return todo_service.delete_todo(todo_id)"}
